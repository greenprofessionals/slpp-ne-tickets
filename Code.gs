/** One-time setup: creates all four sheets with headers, plus both dashboards. */
function setupSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let claims = ss.getSheetByName(CLAIMS_SHEET_NAME);
  if (!claims) claims = ss.insertSheet(CLAIMS_SHEET_NAME);
  claims.clear();
  claims.getRange(1, 1, 1, 11).setValues([[
    'Timestamp', 'Ticket Number', 'Serial', 'Tier', 'Full Name', 'Email', 'Phone', 'Chapter', 'Source', 'Issued By', 'Check-In Token'
  ]]);
  claims.setFrozenRows(1);

  let counter = ss.getSheetByName(COUNTER_SHEET_NAME);
  if (!counter) counter = ss.insertSheet(COUNTER_SHEET_NAME);
  counter.clear();
  counter.getRange('A1').setValue(0);

  let vouchers = ss.getSheetByName(VOUCHERS_SHEET_NAME);
  if (!vouchers) vouchers = ss.insertSheet(VOUCHERS_SHEET_NAME);
  vouchers.clear();
  vouchers.getRange(1, 1, 1, 16).setValues([[
    'Token', 'Batch ID', 'Tier (blank = claimant chooses)', 'Chapter (blank = claimant chooses)',
    'Name (hint, single-voucher batches only)', 'Phone (hint, single-voucher batches only)',
    'Created At', 'Issued By', 'Dispatched', 'Dispatched At', 'Claimed', 'Claimed At',
    'Resulting Serial', 'Resulting Tier', 'Sent To Email', 'Sent To Phone'
  ]]);
  vouchers.setFrozenRows(1);

  let checkins = ss.getSheetByName(CHECKINS_SHEET_NAME);
  if (!checkins) checkins = ss.insertSheet(CHECKINS_SHEET_NAME);
  checkins.clear();
  checkins.getRange(1, 1, 1, 8).setValues([[
    'Timestamp', 'Name', 'Chapter', 'Tier', 'Phone', 'Payment Status', 'Linked Serial', 'Checked In By'
  ]]);
  checkins.setFrozenRows(1);

  // Settings is deliberately NOT cleared if it already exists — re-running
  // setupSheets() should never wipe out a price you've already edited here.
  let settings = ss.getSheetByName(SETTINGS_SHEET_NAME);
  if (!settings) {
    settings = ss.insertSheet(SETTINGS_SHEET_NAME);
    settings.getRange(1, 1, 1, 3).setValues([['Tier Key', 'Label', 'Price ($)']]);
    settings.getRange(2, 1, 3, 3).setValues([
      ['single', 'Single', 100],
      ['patron', 'Single Patron', 150],
      ['double', 'Double Patron', 250]
    ]);
    settings.setFrozenRows(1);
  }

  // Same non-destructive treatment — this is chapter/event branding, edited
  // by hand once per event, never something a setup re-run should reset.
  let eventConfig = ss.getSheetByName(EVENTCONFIG_SHEET_NAME);
  if (!eventConfig) {
    eventConfig = ss.insertSheet(EVENTCONFIG_SHEET_NAME);
    const defaults = getEventConfig();
    eventConfig.getRange(1, 1, 1, 2).setValues([['Key', 'Value']]);
    const rows = Object.keys(defaults).map(k => [k, defaults[k]]);
    eventConfig.getRange(2, 1, rows.length, 2).setValues(rows);
    eventConfig.setFrozenRows(1);
    eventConfig.setColumnWidth(2, 400);
  }

  // Also non-destructive — seeded with the current SLPP chapter list so
  // the live deployment keeps working unchanged; edit or replace freely
  // for a different event's own categories.
  let groups = ss.getSheetByName(GROUPS_SHEET_NAME);
  if (!groups) {
    groups = ss.insertSheet(GROUPS_SHEET_NAME);
    groups.getRange(1, 1, 1, 1).setValues([['Group Name']]);
    const names = getGroups();
    groups.getRange(2, 1, names.length, 1).setValues(names.map(n => [n]));
    groups.setFrozenRows(1);
  }

  buildClaimsVsVouchersChart();
  buildClaimsByChapterChart();
  buildVouchersByStatusChart();
  buildTicketsByTierChart();
  buildRevenueByChapterChart();
}

// ============================================================
// TICKET ISSUANCE — the one function that actually hands out a
// number. Every path (public form, voucher claim, walk-in sale)
// goes through here, so numbers can never collide or repeat.
// ============================================================

function issueTicket(fullName, email, phone, chapter, tier, source, voucherToken, issuedBy, confirmDuplicate) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    fullName = (fullName || '').toString().trim();
    email = (email || '').toString().trim();
    phone = (phone || '').toString().trim();
    chapter = (chapter || 'No Chapter').toString().trim();
    tier = (tier || '').toString().trim().toLowerCase();

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const claimsSheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
    const counterSheet = ss.getSheetByName(COUNTER_SHEET_NAME);

    // Only TIER is ever enforced from a voucher. Name/phone/chapter are
    // prefill-only conveniences — whatever the claimant actually submits
    // for those is what's saved, since none of them show as locked.
    let voucherRowIndex = -1;
    let vouchersSheet = null;
    if (voucherToken) {
      vouchersSheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);
      const data = vouchersSheet.getDataRange().getValues();
      let voucher = null;
      for (let i = 1; i < data.length; i++) {
        if (data[i][0] === voucherToken) { voucherRowIndex = i; voucher = data[i]; break; }
      }
      if (!voucher) return { ok: false, error: 'This voucher link is not valid.' };

      const voucherTier = voucher[2];
      const claimed = voucher[10];
      if (claimed === true || claimed === 'TRUE') {
        const resultSerial = voucher[12] || null;
        return {
          ok: false,
          alreadyClaimed: true,
          error: 'This voucher has already been claimed.',
          serial: resultSerial,
          tier: voucher[13] || null,
          checkInToken: resultSerial ? getCheckInTokenForSerial(resultSerial) : null
        };
      }
      if (voucherTier) tier = voucherTier.toString().toLowerCase();
    }

    if (!tier) tier = 'single';
    if (!validTierKeys().includes(tier)) return { ok: false, error: 'Invalid ticket type.' };
    if (!fullName) return { ok: false, error: 'Full name is required.' };

    // Soft duplicate check: only the open public form, only with contact info given.
    if (!voucherToken && source === 'form' && !confirmDuplicate && (email || phone)) {
      const existingRows = claimsSheet.getLastRow() > 1
        ? claimsSheet.getRange(2, 6, claimsSheet.getLastRow() - 1, 2).getValues()
        : [];
      const emailNorm = email.toLowerCase();
      const phoneNorm = digitsOnly(phone);
      const isDuplicate = existingRows.some(row => {
        const rowEmail = (row[0] || '').toString().toLowerCase();
        const rowPhone = digitsOnly(row[1]);
        return (emailNorm && rowEmail === emailNorm) || (phoneNorm && rowPhone === phoneNorm);
      });
      if (isDuplicate) {
        return { ok: false, duplicateWarning: true, error: 'This phone number or email has already claimed a ticket.' };
      }
    }

    const current = Number(counterSheet.getRange('A1').getValue()) || 0;
    const nextNumber = current + 1;
    counterSheet.getRange('A1').setValue(nextNumber);
    const prefix = getEventConfig().SerialPrefix || 'MA-';
    const serial = prefix + String(nextNumber).padStart(3, '0');
    // A long random secret, NOT the sequential serial, is what actually goes
    // in the QR code — the serial space is tiny (3 digits) and trivially
    // guessable; a UUID gives 2^128 possibilities, effectively unguessable.
    const checkInToken = Utilities.getUuid().replace(/-/g, '');

    claimsSheet.appendRow([new Date(), nextNumber, serial, tier, fullName, email, phone, chapter, source || 'form', issuedBy || '', checkInToken]);

    if (voucherToken && vouchersSheet && voucherRowIndex > -1) {
      vouchersSheet.getRange(voucherRowIndex + 1, 11).setValue(true);       // Claimed
      vouchersSheet.getRange(voucherRowIndex + 1, 12).setValue(new Date()); // Claimed At
      vouchersSheet.getRange(voucherRowIndex + 1, 13).setValue(serial);     // Resulting Serial
      vouchersSheet.getRange(voucherRowIndex + 1, 14).setValue(tier);       // Resulting Tier
    }

    // Email backup: if the claimant gave an email, send a copy of the key
    // details + (for voucher claims) a link that reopens their ticket any
    // time. This is the safety net for "I claimed it but never saved it."
    if (email) {
      try {
        const cfg = getEventConfig();
        const reopenLine = voucherToken
          ? `<p>You can reopen and re-download your ticket anytime here: <a href="${BASE_VOUCHER_URL}?voucher=${encodeURIComponent(voucherToken)}">${BASE_VOUCHER_URL}?voucher=${encodeURIComponent(voucherToken)}</a></p>`
          : '';
        MailApp.sendEmail({
          to: email,
          subject: `Your ticket to ${cfg.EventTitle || 'the event'} — ${serial}`,
          htmlBody: `<p>Hi ${fullName || ''},</p>` +
                    `<p>Your ticket to <strong>${cfg.EventTitle || 'the event'}</strong> (${cfg.ChapterName || ''}) is confirmed.</p>` +
                    `<p><strong>Serial:</strong> ${serial}<br><strong>Ticket type:</strong> ${tier}</p>` +
                    reopenLine
        });
      } catch (e) {
        // Never fail the actual claim just because the confirmation email couldn't send.
      }
    }

    return { ok: true, ticketNumber: String(nextNumber).padStart(3, '0'), serial: serial, tier: tier, checkInToken: checkInToken };

  } finally {
    lock.releaseLock();
  }
}

// ============================================================
// WEB ENTRY POINTS
// ============================================================

function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents);
    const action = body.action || 'claim';

    const routes = {
      verifyPasscode: verifyPasscodeWeb,
      adminGenerateVouchers: adminGenerateVouchersWeb,
      sendVoucher: sendVoucherWeb,
      checkInWithTicket: checkInWithTicketWeb,
      checkInWalkIn: checkInWalkInWeb,
      viewCheckInSummary: viewCheckInSummaryWeb,
      viewVoucherOverview: viewVoucherOverviewWeb,
      uploadLogo: uploadLogoWeb
    };
    if (routes[action]) return jsonResponse(routes[action](body));

    // default: a claimant submitting the claim form, with or without a voucher token
    const source = body.voucher ? 'voucher' : 'form';
    const result = issueTicket(
      body.fullName, body.email, body.phone, body.chapter, body.tier, source, body.voucher,
      undefined, !!body.confirmDuplicate
    );
    return jsonResponse(result);
  } catch (err) {
    return jsonResponse({ ok: false, error: err.message });
  }
}

function doGet(e) {
  const action = e.parameter && e.parameter.action;

  if (action === 'voucher') return jsonResponse(lookupVoucher(e.parameter.token));
  if (action === 'batch') return jsonResponse(lookupBatch(e.parameter.batch));
  if (action === 'config') return jsonResponse({ ok: true, tiers: getTierConfig(), event: getEventConfig(), groups: getGroups() });

  return jsonResponse({ ok: true, message: 'SLPP NE ticket backend is live.' });
}

/** Looks up one voucher for the claim page — what's prefilled, what's locked (tier only), or what it already resolved to if claimed. */
/** Looks up the stored secure check-in token for a given serial — used whenever an already-claimed ticket is redisplayed, so the QR stays consistent rather than regenerating (which would invalidate any copy the person already saved). */
function getCheckInTokenForSerial(serial) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return null;
    const rows = sheet.getRange(2, 1, lastRow - 1, 11).getValues();
    const match = rows.find(row => (row[2] || '').toString().toUpperCase() === serial.toString().toUpperCase());
    return match ? (match[10] || null) : null;
  } catch (e) {
    return null;
  }
}

function lookupVoucher(token) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === token) {
      const row = data[i];
      const claimed = row[10];
      if (claimed === true || claimed === 'TRUE') {
        const resultSerial = row[12] || null;
        return {
          ok: false, alreadyClaimed: true, error: 'This voucher has already been claimed.',
          serial: resultSerial, tier: row[13] || null,
          checkInToken: resultSerial ? getCheckInTokenForSerial(resultSerial) : null
        };
      }
      return { ok: true, name: row[4] || '', phone: row[5] || '', chapter: row[3] || '', tier: row[2] || '' };
    }
  }
  return { ok: false, error: 'This voucher link is not valid.' };
}

/** Lists every voucher in a batch — the distributor's view. */
function lookupBatch(batchId) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);
  const data = sheet.getDataRange().getValues();
  const vouchers = [];
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (row[1] === batchId) {
      vouchers.push({
        token: row[0],
        tier: row[2] || '',
        dispatched: row[8] === true || row[8] === 'TRUE',
        claimed: row[10] === true || row[10] === 'TRUE'
      });
    }
  }
  if (!vouchers.length) return { ok: false, error: 'This distributor link is not valid.' };
  return { ok: true, vouchers: vouchers };
}

// ============================================================
// ADMIN: GENERATE VOUCHERS (unified — size 1 to 10, always a "batch")
// ============================================================

/**
 * One admin action always produces one distributor link. For a single
 * voucher, name/phone are stored as claimant hints. For a multi-voucher
 * batch, the same fields are treated as distributor contact details and
 * are returned to the admin page only; they are NOT copied onto each
 * voucher, so the eventual claimants still enter their own identities.
 */
/**
 * Checks a passcode with no other side effect — used by the web panel to
 * gate the Generate Vouchers and Check-In sections behind a real check,
 * not just a field that happens to sit there unverified.
 */
function verifyPasscodeWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Incorrect passcode.' };
  return { ok: true, issuedBy: issuedBy };
}

/**
 * Accepts a generic tierCounts map ({ tierKey: count, ... }) instead of
 * named fields — works with any number of tiers, since the tier keys
 * themselves come from the Settings sheet, not from this function.
 */
function adminGenerateVouchersWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Not recognized as an admin.' };

  const tierKeys = validTierKeys();
  const tierCountsInput = body.tierCounts || {};
  const counts = {};
  tierKeys.forEach(key => { counts[key] = Math.max(0, parseInt(tierCountsInput[key], 10) || 0); });
  const openCount = Math.max(0, parseInt(body.openCount, 10) || 0);

  const total = tierKeys.reduce((sum, key) => sum + counts[key], 0) + openCount;
  const maxBatch = Number(getEventConfig().MaxBatchSize) || 10;
  if (total < 1) return { ok: false, error: 'Enter at least one voucher across the tiers.' };
  if (total > maxBatch) return { ok: false, error: `Maximum ${maxBatch} vouchers per batch — you entered ${total}.` };

  const chapter = (body.chapter || '').toString().trim();
  const contactName = (body.recipientName || '').toString().trim();
  const contactPhone = (body.recipientPhone || '').toString().trim();
  // Only a batch of one may prefill claimant identity. For larger batches,
  // these values identify the distributor and must never be copied to all
  // vouchers, otherwise every claimant would open a form prefilled as the
  // distributor.
  const name = total === 1 ? contactName : '';
  const phone = total === 1 ? contactPhone : '';

  const batchId = Utilities.getUuid().split('-')[0];
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);

  function addVoucher(tier) {
    const token = Utilities.getUuid().split('-')[0];
    sheet.appendRow([token, batchId, tier, chapter, name, phone, new Date(), issuedBy, false, '', false, '', '', '', '', '']);
  }
  tierKeys.forEach(key => { for (let i = 0; i < counts[key]; i++) addVoucher(key); });
  for (let i = 0; i < openCount; i++) addVoucher('');

  return {
    ok: true,
    distributorUrl: BASE_VOUCHER_URL + '?batch=' + encodeURIComponent(batchId),
    count: total,
    breakdown: Object.assign({}, counts, { open: openCount }),
    issuedBy: issuedBy,
    contactName: contactName,
    contactPhone: contactPhone,
    contactRole: total === 1 ? 'recipient' : 'distributor'
  };
}

/** Marks one voucher "sent" so a distributor can't accidentally give it to two people. The link itself keeps working for whoever received it. */
/**
 * Sends one voucher to a specific recipient — requires an email or phone
 * (at least one), since a voucher can't actually be distributed without
 * somewhere to send it. Records who it was sent to, and if an email was
 * given, sends the real email itself (Text/WhatsApp still open the
 * distributor's own device app pre-filled — there's no free server-side
 * way to send those without a paid third-party SMS/WhatsApp API).
 */
function sendVoucherWeb(body) {
  const token = (body.token || '').toString().trim();
  if (!token) return { ok: false, error: 'Missing voucher token.' };

  const email = (body.recipientEmail || '').toString().trim();
  const phone = (body.recipientPhone || '').toString().trim();
  if (!email && !phone) {
    return { ok: false, error: 'Enter an email or phone number for the recipient before sending.' };
  }

  // Serialize sends so two taps/devices cannot dispatch the same voucher
  // at the same moment.
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);
    const data = sheet.getDataRange().getValues();

    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === token) {
        const dispatched = data[i][8];
        const claimed = data[i][10];
        if (claimed === true || claimed === 'TRUE') {
          return { ok: false, error: 'This voucher has already been claimed.' };
        }
        if (dispatched === true || dispatched === 'TRUE') {
          return { ok: false, error: 'This voucher has already been sent.' };
        }

        const voucherUrl = BASE_VOUCHER_URL + '?voucher=' + encodeURIComponent(token);
        let emailSent = false;

        // For email, do not burn the voucher unless MailApp succeeds.
        if (email) {
          try {
            const cfg = getEventConfig();
            MailApp.sendEmail({
              to: email,
              subject: `Your ticket to ${cfg.EventTitle || 'the event'}`,
              htmlBody: `<p>You've been sent a ticket voucher for <strong>${cfg.EventTitle || 'the event'}</strong> (${cfg.ChapterName || ''}).</p>` +
                        `<p><a href="${voucherUrl}">Click here to claim your ticket</a></p>` +
                        `<p>${voucherUrl}</p>`
            });
            emailSent = true;
          } catch (e) {
            return { ok: false, error: 'Could not send the email: ' + e.message };
          }
        }

        sheet.getRange(i + 1, 9).setValue(true);         // Dispatched
        sheet.getRange(i + 1, 10).setValue(new Date()); // Dispatched At
        sheet.getRange(i + 1, 15).setValue(email);       // Sent To Email
        sheet.getRange(i + 1, 16).setValue(phone);       // Sent To Phone

        return { ok: true, url: voucherUrl, emailSent: emailSent };
      }
    }
    return { ok: false, error: 'Voucher not found.' };
  } finally {
    lock.releaseLock();
  }
}

// ============================================================
// GATE: CHECK-IN (event day, separate concern from ticket issuance)
// ============================================================

/** A guest presenting an existing ticket. Looks up Claims by serial, logs a CheckIns row referencing it. */
function checkInWithTicketWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Not recognized as an admin.' };

  const rawInput = (body.serial || '').toString().trim();
  if (!rawInput) return { ok: false, error: 'Enter a ticket number or scan a QR code.' };

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const claimsSheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
  const lastClaimsRow = claimsSheet.getLastRow();
  if (lastClaimsRow < 2) return { ok: false, error: 'Ticket number not found.' };
  const claims = claimsSheet.getRange(2, 1, lastClaimsRow - 1, 11).getValues();

  // A scanned QR encodes the long secure Check-In Token, not the human
  // serial — try an exact match on that first, since that's the path that
  // actually resists guessing. Manual typing falls back to the serial,
  // which is short and guessable by design, but has a staff member watching.
  let claim = claims.find(row => (row[10] || '').toString() === rawInput);
  let targetSerial;

  if (claim) {
    targetSerial = (claim[2] || '').toString().toUpperCase();
  } else {
    const digits = digitsOnly(rawInput);
    if (!digits) return { ok: false, error: "That doesn't look like a ticket number or QR code." };
    const prefix = getEventConfig().SerialPrefix || 'MA-';
    targetSerial = (prefix + digits.padStart(3, '0')).toUpperCase();
    claim = claims.find(row => (row[2] || '').toString().toUpperCase() === targetSerial);
    if (!claim) return { ok: false, error: 'Ticket number ' + targetSerial + ' not found.' };
  }

  const checkinsSheet = ss.getSheetByName(CHECKINS_SHEET_NAME);
  const lastCheckinRow = checkinsSheet.getLastRow();
  if (lastCheckinRow > 1) {
    const existing = checkinsSheet.getRange(2, 1, lastCheckinRow - 1, 8).getValues();
    const already = existing.find(row => (row[6] || '').toString().toUpperCase() === targetSerial);
    if (already) {
      return {
        ok: false, alreadyCheckedIn: true, error: 'This ticket has already been checked in.',
        name: already[1], chapter: already[2], tier: already[3]
      };
    }
  }

  const name = claim[4], chapter = claim[7], tier = claim[3];
  const phone = (body.phone || '').toString().trim() || claim[6] || '';
  const paymentStatus = body.paymentStatus === 'Pending' ? 'Pending' : 'Paid';

  checkinsSheet.appendRow([new Date(), name, chapter, tier, phone, paymentStatus, targetSerial, issuedBy]);
  return { ok: true, name: name, chapter: chapter, tier: tier, serial: targetSerial, paymentStatus: paymentStatus };
}

/** A walk-in with no prior ticket: issues a real ticket AND logs the check-in in one step. */
function checkInWalkInWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Not recognized as an admin.' };

  const fullName = (body.fullName || '').toString().trim();
  const chapter = (body.chapter || '').toString().trim();
  const tier = (body.tier || '').toString().trim().toLowerCase();
  const phone = (body.phone || '').toString().trim();
  const paymentStatus = body.paymentStatus === 'Pending' ? 'Pending' : 'Paid';

  if (!fullName) return { ok: false, error: 'Name is required.' };
  if (!chapter) return { ok: false, error: 'Chapter is required.' };
  if (!validTierKeys().includes(tier)) return { ok: false, error: 'Ticket type is required.' };

  const issued = issueTicket(fullName, '', phone, chapter, tier, 'walkin', null, issuedBy);
  if (!issued.ok) return issued;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const checkinsSheet = ss.getSheetByName(CHECKINS_SHEET_NAME);
  checkinsSheet.appendRow([new Date(), fullName, chapter, issued.tier, phone, paymentStatus, issued.serial, issuedBy]);

  return { ok: true, name: fullName, chapter: chapter, tier: issued.tier, serial: issued.serial, paymentStatus: paymentStatus, checkInToken: issued.checkInToken };
}

/** Summarizes everyone checked in so far, grouped by chapter, with paid/pending tallies. */
/** Every ticket ever issued (any source: form, voucher, admin, walk-in), grouped by chapter, with the claimant's name. */
/**
 * Full funnel view, grouped by chapter: who's actually gotten a ticket
 * (issued — name, tier, serial, how it was issued) AND what's still
 * outstanding (pending — generated but not yet claimed, whether or not
 * it's been sent to someone). Pulls from Claims (issued) and Vouchers
 * (anything not yet Claimed there is still pending).
 */
function viewVoucherOverviewWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Not recognized as an admin.' };

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const claimsSheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
  const vouchersSheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);

  const byChapter = {};
  function bucket(chapter) {
    const key = (chapter || '').toString().trim() || 'Chapter not yet chosen';
    if (!byChapter[key]) byChapter[key] = { issued: [], pending: [] };
    return byChapter[key];
  }

  let totalIssued = 0, totalPending = 0;

  const claimsLast = claimsSheet.getLastRow();
  if (claimsLast > 1) {
    claimsSheet.getRange(2, 1, claimsLast - 1, 10).getValues().forEach(row => {
      bucket(row[7] || 'No Chapter').issued.push({ name: row[4], tier: row[3], serial: row[2], source: row[8] });
      totalIssued++;
    });
  }

  const vouchersLast = vouchersSheet.getLastRow();
  if (vouchersLast > 1) {
    vouchersSheet.getRange(2, 1, vouchersLast - 1, 14).getValues().forEach(row => {
      const claimed = row[10] === true || row[10] === 'TRUE';
      if (claimed) return; // already represented above, via Claims
      const dispatched = row[8] === true || row[8] === 'TRUE';
      bucket(row[3] || '').pending.push({
        tier: row[2] || '',
        name: row[4] || '',
        status: dispatched ? 'Sent — awaiting claim' : 'Not yet sent'
      });
      totalPending++;
    });
  }

  return { ok: true, totalIssued: totalIssued, totalPending: totalPending, byChapter: byChapter };
}

function viewCheckInSummaryWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Not recognized as an admin.' };

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CHECKINS_SHEET_NAME);
  const lastRow = sheet.getLastRow();

  const byChapter = {};
  let total = 0, paidTotal = 0, pendingTotal = 0;

  if (lastRow > 1) {
    const rows = sheet.getRange(2, 1, lastRow - 1, 8).getValues();
    rows.forEach(row => {
      const chapter = (row[2] || 'No Chapter').toString().trim() || 'No Chapter';
      const paid = row[5] === 'Paid';
      if (!byChapter[chapter]) byChapter[chapter] = { paid: 0, pending: 0, people: [] };
      byChapter[chapter].people.push({ name: row[1], tier: row[3], serial: row[6], paymentStatus: row[5] });
      if (paid) { byChapter[chapter].paid++; paidTotal++; } else { byChapter[chapter].pending++; pendingTotal++; }
      total++;
    });
  }

  return { ok: true, total: total, paidTotal: paidTotal, pendingTotal: pendingTotal, byChapter: byChapter };
}

