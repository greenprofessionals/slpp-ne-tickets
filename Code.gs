/**
 * ESTIMATED revenue by chapter — ticket count × face value ($100/$150/$250).
 * This is an estimate, not a confirmed-payment figure: this system only
 * tracks actual Paid/Pending status for gate check-ins (CheckIns sheet),
 * not for online claims, which have no payment step at all.
 */
function buildRevenueByChapterChart() {
  const tierConfig = getTierConfig();
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
  const lastRow = sheet.getLastRow();

  const revenue = {};
  if (lastRow > 1) {
    sheet.getRange(2, 1, lastRow - 1, 10).getValues().forEach(row => {
      const tier = (row[3] || '').toString().toLowerCase();
      const chapter = (row[7] || 'No Chapter').toString().trim() || 'No Chapter';
      const price = (tierConfig[tier] && tierConfig[tier].price) || 0;
      revenue[chapter] = (revenue[chapter] || 0) + price;
    });
  }

  let sheetOut = ss.getSheetByName('Revenue by Chapter');
  if (!sheetOut) sheetOut = ss.insertSheet('Revenue by Chapter');
  sheetOut.getCharts().forEach(c => sheetOut.removeChart(c));
  sheetOut.clear();
  sheetOut.getRange(1, 1, 1, 2).setValues([['Chapter', 'Estimated Revenue ($)']]);
  const rows = Object.keys(revenue).sort().map(ch => [ch, revenue[ch]]);
  if (rows.length) sheetOut.getRange(2, 1, rows.length, 2).setValues(rows);

  const chart = sheetOut.newChart()
    .setChartType(Charts.ChartType.BAR)
    .addRange(sheetOut.getRange(1, 1, rows.length + 1, 2))
    .setPosition(rows.length + 4, 1, 0, 0)
    .setOption('title', 'Estimated Revenue by Chapter (face value, not confirmed payment)')
    .setOption('legend', { position: 'none' })
    .setOption('width', 700).setOption('height', Math.max(350, rows.length * 30))
    .build();
  sheetOut.insertChart(chart);
}

/**
 * Run this ONCE (Sheet menu → "Create Configuration Form"). Builds a
 * Google Form covering every EventConfig field, all tiers (up to 5), the
 * groups list and optional image URLs. Logo file attachments are uploaded
 * separately on config.html because FormApp cannot create file-upload questions.
 * Responses land in a
 * sheet named "ConfigFormResponses" — getEventConfig()/getTierConfig()/
 * getGroups() all read the MOST RECENT submission from there automatically.
 * Submitting the form again updates the live configuration; nothing here
 * requires touching a Sheet cell directly.
 */
function createConfigForm() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const existingNames = ss.getSheets().map(s => s.getName());

  const form = FormApp.create('Event Configuration');
  form.setDescription(
    'Configure this event\'s branding, ticket tiers, and groups. ' +
    'Submitting this form again creates a NEW response — the most recent one is what the system actually uses.'
  );

  const text = (title, help) => form.addTextItem().setTitle(title).setHelpText(help || '');
  const para = (title, help) => form.addParagraphTextItem().setTitle(title).setHelpText(help || '');

  text('OrgName', 'e.g. SLPP North America');
  text('ChapterName', 'e.g. New England Chapter');
  text('EventTitle', 'e.g. Executive Inauguration Celebration');
  para('Tagline', 'Optional subtitle shown under the event title on the ticket');
  text('EventDate', 'e.g. Saturday, August 22, 2026');
  text('EventTime', 'e.g. 6:00 PM');
  text('VenueName');
  text('VenueAddress');
  text('ContactPhone');
  text('WebsiteURL');
  text('DressCode');
  text('PrimaryColor', 'Hex code, e.g. #0b3d24');
  text('GoldColor', 'Hex code, e.g. #c9a24b');
  text('SerialPrefix', 'e.g. MA-');
  text('CurrencySymbol', 'e.g. $');
  text('FooterLegalText', 'Small print on the ticket, e.g. refund policy');
  text('MaxBatchSize', 'Max vouchers per admin-generated batch, e.g. 10');

  form.addMultipleChoiceItem().setTitle('UseGroups')
    .setHelpText('Does this event use a grouping category (chapter/team/table)?')
    .setChoiceValues(['true', 'false']);
  text('GroupLabel', 'What to call the grouping — e.g. Chapter, Team, Table');
  para('GroupsList', 'One group name per line. Leave blank if UseGroups is false.');

  for (let i = 1; i <= 5; i++) {
    text(`Tier${i}Name`, `Optional — leave blank to skip. e.g. Single`);
    text(`Tier${i}Price`, `Price for tier ${i}, numbers only`);
  }

  // Google Apps Script FormApp cannot create a file-upload question programmatically.
  // A logo can be uploaded directly on config.html (recommended), or a public image URL can be pasted here.
  text('LogoURL', 'Optional public image URL. For an image attachment instead, use the Logo Upload section on config.html.');
  text('BackgroundURL', 'Optional public ticket background image URL.');

  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  // Find whichever sheet Forms just created and rename it to something stable,
  // since getLatestFormResponse() reads by this exact name.
  const newSheets = ss.getSheets().filter(s => !existingNames.includes(s.getName()));
  if (newSheets.length) newSheets[0].setName(CONFIG_FORM_RESPONSES_SHEET);

  SpreadsheetApp.getUi().alert(
    'Configuration form created',
    'Editor link (manage the form):\n' + form.getEditUrl() +
    '\n\nPublished link (send this to whoever fills it out):\n' + form.getPublishedUrl() +
    '\n\nFile uploads land in a Drive folder tied to this form — the system reads the uploaded file directly, no extra steps needed.',
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}

function jsonResponse(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
