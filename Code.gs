function menuGenerateVouchers() {
  const ui = SpreadsheetApp.getUi();
  const passResp = ui.prompt('Generate Vouchers — Step 1', 'Your admin passcode:', ui.ButtonSet.OK_CANCEL);
  if (passResp.getSelectedButton() !== ui.Button.OK) return;
  const adminPasscode = passResp.getResponseText().trim();

  const tierConfig = getTierConfig();
  const tierKeys = Object.keys(tierConfig);
  const tierCounts = {};
  let step = 2;
  for (const key of tierKeys) {
    const cfg = tierConfig[key];
    const r = ui.prompt(`Step ${step} of ${tierKeys.length + 2}`, `How many ${cfg.label} ($${cfg.price})?`, ui.ButtonSet.OK_CANCEL);
    if (r.getSelectedButton() !== ui.Button.OK) return;
    tierCounts[key] = r.getResponseText().trim();
    step++;
  }

  const o = ui.prompt(`Step ${step} of ${tierKeys.length + 2}`, 'How many with NO fixed tier (recipient picks)?', ui.ButtonSet.OK_CANCEL);
  if (o.getSelectedButton() !== ui.Button.OK) return;
  const openCount = o.getResponseText().trim();
  step++;

  const c = ui.prompt(`Step ${step} of ${tierKeys.length + 2} (optional)`, 'Group/chapter to suggest — blank lets recipient(s) choose:', ui.ButtonSet.OK_CANCEL);
  if (c.getSelectedButton() !== ui.Button.OK) return;
  const chapter = c.getResponseText().trim();

  const result = adminGenerateVouchersWeb({ adminPasscode, tierCounts, openCount, chapter });
  if (!result.ok) { ui.alert('Could not generate', result.error, ui.ButtonSet.OK); return; }
  const b = result.breakdown;
  const breakdownText = tierKeys.map(k => `${b[k]} ${tierConfig[k].label}`).join(', ') + `, ${b.open} no fixed tier.`;
  ui.alert(
    'Vouchers generated — copy and send it',
    result.distributorUrl + `\n\n${breakdownText}` + `\n\nIssued by: ${result.issuedBy}`,
    ui.ButtonSet.OK
  );
}

function menuCheckInWithTicket() {
  const ui = SpreadsheetApp.getUi();
