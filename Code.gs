function menuViewCheckInSummary() {
  const ui = SpreadsheetApp.getUi();
  const passResp = ui.prompt('View Check-In Summary', 'Your admin passcode:', ui.ButtonSet.OK_CANCEL);
  if (passResp.getSelectedButton() !== ui.Button.OK) return;
  const adminPasscode = passResp.getResponseText().trim();

  const result = viewCheckInSummaryWeb({ adminPasscode });
