function menuCheckInWalkIn() {
  const ui = SpreadsheetApp.getUi();
  const passResp = ui.prompt('Check In — Walk-In', 'Your admin passcode:', ui.ButtonSet.OK_CANCEL);
  if (passResp.getSelectedButton() !== ui.Button.OK) return;
  const adminPasscode = passResp.getResponseText().trim();

  const nameResp = ui.prompt('Guest full name:', '', ui.ButtonSet.OK_CANCEL);
