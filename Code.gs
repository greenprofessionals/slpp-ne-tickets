/**
 * SLPP New England Chapter — Ticket Voucher Backend
 * ------------------------------------------------
 * Three user groups, three sheets that reflect them:
 *
 *   ADMIN        generates vouchers and hands them to a DISTRIBUTOR.
 *                Even a single ticket is a "batch of 1" — there is no
 *                separate "solo invite" concept anymore. One admin action,
 *                one distributor link, any size from 1 to 10.
 *
 *   DISTRIBUTOR  opens that one link, sees every voucher in the batch,
 *                and either shares each one to a different CLAIMANT via
 *                Text/WhatsApp, or claims one for themselves directly.
 *                Once a voucher is sent OR claimed, it's done — no
 *                re-sending, no double use.
 *
 *   CLAIMANT     opens their individual voucher link (or the open public
 *                form) and fills in their own details to receive a ticket.
 *
 * On event day, a separate concern — CHECK-IN — happens at the door:
 *   - A guest who already has a ticket presents their serial number.
 *   - A walk-in guest with no prior ticket buys one on the spot.
 * Both end up in the CheckIns sheet with Name/Chapter/Tier/Phone/Payment
 * Status, which is deliberately separate from Claims — Claims tracks who
 * holds a valid ticket number, CheckIns tracks who is actually AT the
 * event and whether they've paid. A walk-in gets both: a real Claims
 * entry (so ticket counts stay accurate) and a CheckIns entry.
 *
 * FOUR SHEETS:
 *   Claims    — every ticket ever issued (any source)
 *   Counter   — single cell, the next ticket number to hand out
 *   Vouchers  — every voucher ever generated by an admin, batched
 *   CheckIns  — every person confirmed physically present at the door
 *
 * SETUP:
 * 1. Create a new Google Sheet.
 * 2. Extensions → Apps Script. Delete any starter code, paste this file in.
 * 3. Run `setupSheets()` once (creates all four sheets + two dashboards).
 * 4. Deploy → New deployment → Web app → Execute as Me → Access: Anyone.
 * 5. Copy the Web App URL into claim.html's CONFIG.ENDPOINT.
 * 6. Set BASE_CLAIM_URL below to your real GitHub Pages claim.html URL.
 */

const CLAIMS_SHEET_NAME = 'Claims';
const COUNTER_SHEET_NAME = 'Counter';
const VOUCHERS_SHEET_NAME = 'Vouchers';
const CHECKINS_SHEET_NAME = 'CheckIns';
const SETTINGS_SHEET_NAME = 'Settings';
const EVENTCONFIG_SHEET_NAME = 'EventConfig';

// TODO: set this to your real GitHub Pages URL once claim.html is live.
const BASE_CLAIM_URL = 'https://greenprofessionals.github.io/slpp-ne-tickets/claim.html';
// The lean, admin-free, no-preview-image page used for every voucher/batch
// link actually sent to a distributor or claimant. Keeps admin tools and
// rich link previews off anything that leaves your hands.
const BASE_VOUCHER_URL = 'https://greenprofessionals.github.io/slpp-ne-tickets/v.html';

/**
 * Admin passcodes — backend-only, never appears on the public claim.html
 * page. Used to identify who performed an action (for logging) and to
 * gate every admin/distributor/gate action reachable from the web panel.
 */
const ADMIN_DIRECTORY = {
  'kulane2026': 'Kula Sillah — New England Chapter (NEC)',
  'fombany2026': 'Test Admin (testing number)'
};

/** Live tier keys, read from Settings each time — not a fixed array. Any number of tiers works. */
function validTierKeys() {
  return Object.keys(getTierConfig());
}

function digitsOnly(str) {
  return (str || '').toString().replace(/\D/g, '');
}

/**
 * Reads current tier labels/prices from the Settings sheet. This is the
 * single source of truth — nothing else in this file hardcodes a price.
 * If Settings is missing or malformed, falls back to sane defaults so a
 * fresh/broken sheet never crashes the whole system.
 */
function getTierConfig() {
  const fallback = {
    single: { label: 'Single', price: 100 },
    patron: { label: 'Single Patron', price: 150 },
    double: { label: 'Double Patron', price: 250 }
  };
  try {
    const formResponse = getLatestFormResponse();
    if (formResponse) {
      const config = {};
      for (let i = 1; i <= 5; i++) {
        const name = (formResponse[`Tier${i}Name`] || '').toString().trim();
        if (!name) continue;
        const price = Number(formResponse[`Tier${i}Price`]) || 0;
        const key = name.toLowerCase().replace(/[^a-z0-9]+/g, '') || `tier${i}`;
        config[key] = { label: name, price: price };
      }
      if (Object.keys(config).length) return config;
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(SETTINGS_SHEET_NAME);
    if (!sheet) return applyUploadedBrandAssets_(fallback);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return applyUploadedBrandAssets_(fallback);
    const config = {};
    sheet.getRange(2, 1, lastRow - 1, 3).getValues().forEach(row => {
      const key = (row[0] || '').toString().trim().toLowerCase();
      if (!key) return;
      config[key] = { label: (row[1] || key).toString().trim(), price: Number(row[2]) || 0 };
    });
    return Object.keys(config).length ? config : fallback;
  } catch (e) {
    return fallback;
  }
}

/**
 * Reads event/chapter branding from the EventConfig sheet (key-value pairs).
 * This is what makes the whole system reusable by any chapter — swap these
 * values and the page header + generated ticket both rebrand automatically,
 * no code or artwork changes needed.
 */
function getEventConfig() {
  const fallback = {
    OrgName: 'SLPP North America',
    ChapterName: 'New England Chapter',
    EventTitle: 'Executive Inauguration Celebration',
    Tagline: 'Celebrating the Inauguration of the Executive of the New England Chapter',
    EventDate: 'Saturday, August 22, 2026',
    EventTime: '6:00 PM',
    VenueName: 'Prince Hall Grand Lodge',
    VenueAddress: '24 Washington St, Dorchester, MA, 02121',
    ContactPhone: '(678) 301-8876',
    WebsiteURL: 'https://greenprofessionals.github.io/slpp_new_england_chapter.html',
    DressCode: 'Formal / Traditional',
    PrimaryColor: '#0b3d24',
    GoldColor: '#c9a24b',
    LogoURL: '',
    BackgroundURL: '',
    GroupLabel: 'Chapter',
    UseGroups: 'true',
    SerialPrefix: 'MA-',
    CurrencySymbol: '$',
    FooterLegalText: 'Ticket must be presented for admission · No refunds or replacements',
    MaxBatchSize: '10'
  };
  try {
    // The config Form, if it's been submitted at least once, wins over the
    // manually-edited EventConfig sheet — this is the intended "configure
    // via Form, not by touching the Sheet" path.
    const formResponse = getLatestFormResponse();
    if (formResponse) {
      const cfg = Object.assign({}, fallback);
      Object.keys(fallback).forEach(key => {
        const v = formResponse[key];
        if (v !== undefined && v !== null && v.toString().trim() !== '') {
          cfg[key] = normalizeConfigValue(key, v);
        }
      });
      if (formResponse['LogoImage']) {
        const embedded = driveUploadToDataUrl(formResponse['LogoImage']);
        if (embedded) cfg.LogoURL = embedded;
      }
      if (formResponse['BackgroundImage']) {
        const embedded = driveUploadToDataUrl(formResponse['BackgroundImage']);
        if (embedded) cfg.BackgroundURL = embedded;
      }
      return applyUploadedBrandAssets_(cfg);
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(EVENTCONFIG_SHEET_NAME);
    if (!sheet) return fallback;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return fallback;
    const config = Object.assign({}, fallback);
    sheet.getRange(2, 1, lastRow - 1, 2).getValues().forEach(row => {
      const key = (row[0] || '').toString().trim();
      if (!key) return;
      const value = (row[1] || '').toString().trim();
      if (value) config[key] = value;
    });
    return applyUploadedBrandAssets_(config);
  } catch (e) {
    return applyUploadedBrandAssets_(fallback);
  }
}

const GROUPS_SHEET_NAME = 'Groups';
const CONFIG_FORM_RESPONSES_SHEET = 'ConfigFormResponses';

/**
 * Reads the MOST RECENT submission of the configuration Google Form (see
 * createConfigForm()) as a plain { headerText: value } object. Returns
 * null if the form hasn't been created/submitted yet — every config
 * getter below treats that as "fall back to the old sheet-based config,"
 * so nothing breaks for a deployment that hasn't switched to the form.
 */
function getLatestFormResponse() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(CONFIG_FORM_RESPONSES_SHEET);
    if (!sheet) return null;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return null;
    const lastCol = sheet.getLastColumn();
    const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
    const values = sheet.getRange(lastRow, 1, 1, lastCol).getValues()[0];
    const result = {};
    headers.forEach((h, i) => { result[h] = values[i]; });
    return result;
  } catch (e) {
    return null;
  }
}

/** Normalize Google Forms/Sheets date and time values for display. */
function normalizeConfigValue(key, value) {
  if (value === null || value === undefined) return '';
  if (Object.prototype.toString.call(value) === '[object Date]' && !isNaN(value.getTime())) {
    const tz = Session.getScriptTimeZone() || 'America/New_York';
    if (key === 'EventDate') return Utilities.formatDate(value, tz, 'EEEE, MMMM d, yyyy');
    if (key === 'EventTime') return Utilities.formatDate(value, tz, 'h:mm a');
  }
  const raw = String(value).trim();
  if (key === 'EventTime') {
    const m = raw.match(/\b(\d{1,2}):(\d{2})(?::\d{2})?\b/);
    if (m && /1899|GMT|Standard Time|Daylight Time/i.test(raw)) {
      let h = Number(m[1]);
      const min = m[2];
      const suffix = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return `${h}:${min} ${suffix}`;
    }
  }
  if (key === 'EventDate') {
    const d = new Date(raw);
    if (!isNaN(d.getTime())) {
      const tz = Session.getScriptTimeZone() || 'America/New_York';
      return Utilities.formatDate(d, tz, 'EEEE, MMMM d, yyyy');
    }
  }
  return raw;
}

/** Convert a Google Forms file-upload answer to an embeddable data URL. */
function driveUploadToDataUrl(url) {
  if (!url) return '';
  const match = url.toString().match(/[-\w]{25,}/);
  if (!match) return '';
  try {
    const blob = DriveApp.getFileById(match[0]).getBlob();
    const mime = blob.getContentType() || 'image/png';
    return `data:${mime};base64,${Utilities.base64Encode(blob.getBytes())}`;
  } catch (e) {
    return '';
  }
}


/** Read an uploaded branding asset stored by this web app and return a data URL. */
function uploadedAssetDataUrl_(propertyKey) {
  try {
    const fileId = PropertiesService.getScriptProperties().getProperty(propertyKey);
    if (!fileId) return '';
    const blob = DriveApp.getFileById(fileId).getBlob();
    const mime = blob.getContentType() || 'image/png';
    return `data:${mime};base64,${Utilities.base64Encode(blob.getBytes())}`;
  } catch (e) {
    return '';
  }
}

/** Uploaded assets from config.html take priority over URL/form fallbacks. */
function applyUploadedBrandAssets_(cfg) {
  const logo = uploadedAssetDataUrl_('TICKET_LOGO_FILE_ID');
  if (logo) cfg.LogoURL = logo;
  return cfg;
}

/** Save a logo uploaded from config.html. */
function uploadLogoWeb(body) {
  const issuedBy = requireAdmin(body.adminPasscode);
  if (!issuedBy) return { ok: false, error: 'Incorrect admin passcode.' };

  const dataUrl = (body.dataUrl || '').toString();
  const fileName = (body.fileName || 'ticket-logo.png').toString().replace(/[^a-zA-Z0-9._-]/g, '_');
  const match = dataUrl.match(/^data:(image\/(?:png|jpeg|jpg|webp));base64,([A-Za-z0-9+/=]+)$/i);
  if (!match) return { ok: false, error: 'Choose a PNG, JPG, JPEG, or WebP logo image.' };

  const bytes = Utilities.base64Decode(match[2]);
  const maxBytes = 2 * 1024 * 1024;
  if (bytes.length > maxBytes) return { ok: false, error: 'Logo is too large. Please use an image smaller than 2 MB.' };

  const mime = match[1].toLowerCase() === 'image/jpg' ? 'image/jpeg' : match[1].toLowerCase();
  const blob = Utilities.newBlob(bytes, mime, fileName);

  let folder;
  const folders = DriveApp.getFoldersByName('Ticket System Assets');
  folder = folders.hasNext() ? folders.next() : DriveApp.createFolder('Ticket System Assets');
  const file = folder.createFile(blob);

  const props = PropertiesService.getScriptProperties();
  const oldId = props.getProperty('TICKET_LOGO_FILE_ID');
  props.setProperty('TICKET_LOGO_FILE_ID', file.getId());
  if (oldId && oldId !== file.getId()) {
    try { DriveApp.getFileById(oldId).setTrashed(true); } catch (e) { /* keep going */ }
  }

  return { ok: true, fileName: file.getName(), uploadedBy: issuedBy };
}

/** Converts a Google Forms file-upload response (a Drive file URL) into a directly-embeddable image URL, and makes the file viewable so a browser can actually load it. */
function driveUrlToDirectImage(url) {
  if (!url) return '';
  const match = url.toString().match(/[-\w]{25,}/);
  if (!match) return '';
  const fileId = match[0];
  try {
    DriveApp.getFileById(fileId).setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (e) { /* best-effort — if this fails the image just won't load, non-fatal */ }
  return `https://drive.google.com/uc?export=view&id=${fileId}`;
}



/**
 * Reads the list of group/chapter options from the Groups sheet — one
 * name per row. This is what lets the dropdown be arbitrary categories
 * for ANY event (teams, tables, regions), not a fixed SLPP chapter list.
 * Falls back to the current SLPP chapter list only if the sheet is
 * missing entirely, so the existing New England deployment never breaks.
 */
function getGroups() {
  const fallback = [
    'No Chapter', 'Arizona Chapter (AZC)', 'Atlanta GA Chapter (GAC)', 'Chicago Chapter (ILC)',
    'Dallas Chapter (TXDC)', 'Delaware Valley Chapter (DVC)', 'DRC Chapter (DRC)', 'Florida Chapter (FLC)',
    'Houston Chapter (TXHC)', 'Iowa Chapter (IAC)', 'Minnesota Chapter (MNC)', 'New England Chapter (NEC)',
    'New Jersey Chapter (NJC)', 'New York Chapter (NYC)', 'North Dakota Chapter (NDC)',
    'Northern California Chapter (CANC)', 'Ohio Chapter (OHC)', 'Seattle Washington Chapter (SWC)',
    'Southern California Chapter (CASC)', 'Virginia Chapter (VAC)', 'Washington DC Chapter (WDC)'
  ];
  try {
    const formResponse = getLatestFormResponse();
    if (formResponse && formResponse['GroupsList']) {
      const names = formResponse['GroupsList'].toString().split('\n').map(s => s.trim()).filter(Boolean);
      if (names.length) return names;
    }

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName(GROUPS_SHEET_NAME);
    if (!sheet) return fallback;
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return fallback;
    const names = sheet.getRange(2, 1, lastRow - 1, 1).getValues()
      .map(r => (r[0] || '').toString().trim())
      .filter(Boolean);
    return names.length ? names : fallback;
  } catch (e) {
    return fallback;
  }
}

/** Looks up a passcode, never blocks — used only for Sheet-menu tools where Editor access already implies trust. */
function identifyAdmin(passcode) {
  const key = (passcode || '').toString().trim().toLowerCase();
  return ADMIN_DIRECTORY[key] || (passcode ? 'Unrecognized admin (invalid passcode)' : 'Unknown admin');
}

/** Returns the directory name if valid, or null — used by every public web endpoint, and DOES block on a miss. */
function requireAdmin(passcode) {
  const key = (passcode || '').toString().trim().toLowerCase();
  return ADMIN_DIRECTORY[key] || null;
}

