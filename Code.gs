function refreshDashboards() {
  buildClaimsVsVouchersChart();
  buildClaimsByChapterChart();
  buildVouchersByStatusChart();
  buildTicketsByTierChart();
  buildRevenueByChapterChart();
  SpreadsheetApp.getUi().alert('Dashboards refreshed', 'All five charts have been updated with the latest counts.', SpreadsheetApp.getUi().ButtonSet.OK);
}

function buildClaimsVsVouchersChart() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const totalClaims = Math.max(ss.getSheetByName(CLAIMS_SHEET_NAME).getLastRow() - 1, 0);
  const totalVouchers = Math.max(ss.getSheetByName(VOUCHERS_SHEET_NAME).getLastRow() - 1, 0);

  let dash = ss.getSheetByName('Claims vs Vouchers');
  if (!dash) dash = ss.insertSheet('Claims vs Vouchers');
  dash.getCharts().forEach(c => dash.removeChart(c));
  dash.clear();
  dash.getRange('A1:B1').setValues([['Metric', 'Count']]);
  dash.getRange('A2:B3').setValues([['Claims', totalClaims], ['Vouchers', totalVouchers]]);

  const chart = dash.newChart()
    .setChartType(Charts.ChartType.BAR)
    .addRange(dash.getRange('A1:B3'))
    .setPosition(5, 1, 0, 0)
    .setOption('title', 'Claims vs Vouchers Generated')
    .setOption('legend', { position: 'none' })
    .setOption('width', 600).setOption('height', 350)
    .build();
  dash.insertChart(chart);
}

function buildClaimsByChapterChart() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const claimsSheet = ss.getSheetByName(CLAIMS_SHEET_NAME);
  const lastRow = claimsSheet.getLastRow();

  const counts = {};
  if (lastRow > 1) {
    claimsSheet.getRange(2, 8, lastRow - 1, 1).getValues().forEach(r => {
      const ch = (r[0] || 'No Chapter').toString().trim() || 'No Chapter';
      counts[ch] = (counts[ch] || 0) + 1;
    });
  }

  let sheet = ss.getSheetByName('Claims by Chapter');
  if (!sheet) sheet = ss.insertSheet('Claims by Chapter');
  sheet.getCharts().forEach(c => sheet.removeChart(c));
  sheet.clear();
  sheet.getRange(1, 1, 1, 2).setValues([['Chapter', 'Claims']]);
  const rows = Object.keys(counts).sort().map(ch => [ch, counts[ch]]);
  if (rows.length) sheet.getRange(2, 1, rows.length, 2).setValues(rows);

  const chart = sheet.newChart()
    .setChartType(Charts.ChartType.BAR)
    .addRange(sheet.getRange(1, 1, rows.length + 1, 2))
    .setPosition(rows.length + 4, 1, 0, 0)
    .setOption('title', 'Claims by Chapter')
    .setOption('legend', { position: 'none' })
    .setOption('width', 700).setOption('height', Math.max(350, rows.length * 30))
    .build();
  sheet.insertChart(chart);
}

/** Where vouchers actually stand: claimed, sent-but-unclaimed, or never sent. Shows if generation is outpacing conversion. */
function buildVouchersByStatusChart() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(VOUCHERS_SHEET_NAME);
  const lastRow = sheet.getLastRow();

  let claimed = 0, sentUnclaimed = 0, notSent = 0;
  if (lastRow > 1) {
    sheet.getRange(2, 1, lastRow - 1, 14).getValues().forEach(row => {
      const isClaimed = row[10] === true || row[10] === 'TRUE';
      const isDispatched = row[8] === true || row[8] === 'TRUE';
      if (isClaimed) claimed++;
      else if (isDispatched) sentUnclaimed++;
      else notSent++;
    });
  }

  let dash = ss.getSheetByName('Vouchers by Status');
  if (!dash) dash = ss.insertSheet('Vouchers by Status');
  dash.getCharts().forEach(c => dash.removeChart(c));
  dash.clear();
  dash.getRange('A1:B1').setValues([['Status', 'Count']]);
  dash.getRange('A2:B4').setValues([['Claimed', claimed], ['Sent, awaiting claim', sentUnclaimed], ['Not yet sent', notSent]]);

  const chart = dash.newChart()
    .setChartType(Charts.ChartType.BAR)
    .addRange(dash.getRange('A1:B4'))
    .setPosition(6, 1, 0, 0)
    .setOption('title', 'Vouchers by Status')
    .setOption('legend', { position: 'none' })
    .setOption('width', 600).setOption('height', 350)
    .build();
  dash.insertChart(chart);
}

